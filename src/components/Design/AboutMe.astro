---
import IllustratorIcon from "../../components/icons/illustrator.astro";
import FigmaIcon from "../../components/icons/figma.astro";
import AffinityDesignIcon from "../../components/icons/affinitydesign.astro";
import CanvaIcon from "../../components/icons/canva.astro";
import WordpressIcon from "../../components/icons/wordpress.astro";
import ElementorIcon from "../../components/icons/elementor.astro";

const personalImageAlt = "Anabel";
const avatarUrl = import.meta.env.PUBLIC_AVATAR_URL || "/perfil.jpg";

const albums = [
  {
    id: 1,
    title: "Living Things",
    artist: "Linkin Park",
    image: "/albums/living-things.jpg"
  }, 
  {
    id: 2,
    title: "Spirit",
    artist: "Bring Me The Horizon",
    image: "/albums/spirit.jpg"
  },
  {
    id: 3,
    title: "Post Human",
    artist: "Bring Me The Horizon",
    image: "/albums/post-human.jpg"
  },
  {
    id: 4,
    title: "Meteora",
    artist: "Linkin Park",
    image: "/albums/lp.jpg"
  }
]

---
  <!-- Grid principal -->
  <div class="grid grid-cols-1 gap-5 md:grid-cols-12">
      <article class="flex min-h-[420px] flex-col justify-between
               rounded-2xl bg-white p-6 md:col-span-7 md:row-span-2">
        <div>
          <h3 class="mb-3 font-semibold primary-color">
            HISTORIA DE ORIGEN
          </h3>
          <p class="text-base/7 text-gray-600">Me presento, soy Anabel.
            <br> Mi historia con el diseño comenzó aproximadamente a los 10 años, cuando observaba a mi hermana mayor trabajar con herramientas como CorelDRAW y Photoshop. Me fascinaba descubrir todo lo que podía crearse a través de ellas: las posibilidades, los colores, las formas y la libertad de transformar una idea en algo visual.
            <br>Aquella curiosidad despertó en mí un interés especial por el diseño gráfico. Desde entonces, supe que algún día quería estudiar y dedicarme a este mundo creativo.
            <br><br>Hoy, en 2026, he decidido dar ese paso y comenzar una nueva etapa. 
          </p>
        </div>

        <div class="flex flex-wrap gap-2">
          <span class="rounded-full bg-sky-100 px-3 py-2 text-xs text-blue-700">
            De Lima, Perú
          </span>
          <span class="rounded-full bg-sky-100 px-3 py-2 text-xs text-blue-700">
            Disponible para trabajo
          </span>
        </div>
      </article>

      <div class="h-[195px] rounded-2xl bg-blue-200 md:col-span-5">
        <img src={avatarUrl} alt={personalImageAlt} class="w-full h-full object-cover rounded-2xl" />
      </div>

      <div class="flex justify-center items-center rounded-2xl min-h-[195px] bg-slate-950 md:col-span-5">
        <img src="/nightwing.svg" alt="nightwing">
      </div>

      <!-- Herramientas -->
      <article class="min-h-[214px] rounded-2xl bg-sky-600  p-6 md:col-span-6">
        <h3 class="mb-5 font-semibold primary-color"> HERRAMIENTAS </h3>
          <div class="flex flex-wrap gap-4 my-5">
              <FigmaIcon class="size-10" />
              <IllustratorIcon class="size-10" />
              <AffinityDesignIcon class="size-10" />
              <CanvaIcon class="size-10" />
              <WordpressIcon class="size-10" />
              <ElementorIcon class="size-10" />
          </div>
      </article>

      <!-- Tarjeta inferior derecha -->
        <div class="min-h-[214px] flex justify-center flex-wrap gap-2 items-center bg-white/60 rounded-2xl md:col-span-6">
          {albums.map((albums) => (
            <img src={albums.image} alt={albums.title} class="xl:w-1/5 w-24 object-cover rounded-2xl" />
          ))}
        </div>
      </div>
  </div>