---
import MailIcon from "../icons/email.astro";
import LinkedinIcon from "../icons/linkedin.astro";
import CvIcon from "../icons/cv.astro";
import SocialBtn from "../SocialBtn.astro";

const avatarUrl = import.meta.env.PUBLIC_AVATAR_URL || "/perfil.jpg";
---
<div class="">
    <h1 class="text_white text-2xl md:text-4xl lg:text-5xl 
    font-semibold pb-6 lg:pb-5 ">
        Bienvenido a mi portfolio</h1>
    
    <h2 class="text-xl text-wrap opacity-80 max-w-[700px]"> <strong> Diseñadora UX/UI </strong> y Digital con experiencia en diseño de interfaces y desarrollo Front End, actualmente cursando Diseño Gráfico Digital. 
        Interesada en diseño gráfico, branding, contenido digital y experiencias visuales para plataformas digitales.
    </h2>

    <nav class="flex gap-3 mt-8 flex-wrap">
        <SocialBtn href="https://www.linkedin.com/in/anabelhuancam/" >
        <LinkedinIcon class="size-4 md:size-6" aria-label="LinkedIn" />
        LinkedIn
        </SocialBtn>

        <SocialBtn href="mailto:anabel.humor@gmail.com" >
            <MailIcon class="size-4  md:size-6" aria-label="Email" />
            Contáctame
        </SocialBtn>

        <SocialBtn href="https://drive.google.com/file/d/1FpP0uUzPbZk6eOnHiyWUT4TR5djwqFpT/view?usp=sharing" >
            <CvIcon class="size-4  md:size-6" aria-label="PDF CV" />
            Ver CV
        </SocialBtn>
    </nav>
</div>