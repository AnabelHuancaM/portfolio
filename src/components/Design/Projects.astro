---
import { graphicProjects } from "../../data/designProjects.js";
import FigmaIcon from "../icons/figma.astro";
import IllustratorIcon from "../icons/illustrator.astro";
import AffinityDesignerIcon from "../icons/affinitydesign.astro";
import PhotoshopIcon from "../icons/photoshop.astro";


const toolIcons = {
    Figma: FigmaIcon,
    Illustrator: IllustratorIcon,
    AffinityDesigner: AffinityDesignerIcon,
    Photoshop: PhotoshopIcon,
};
---
<div id="design-projects" class="grid grid-cols-1 gap-4 py-8 sm:grid-cols-2 lg:grid-cols-3">
    {graphicProjects.map(({ id, title, image, category }) => (
        <button
            type="button"
            class="group relative isolate flex min-h-[300px] w-full items-end overflow-hidden rounded-xl border border-white/10 p-5 text-left shadow-lg"
            data-gallery-open={id}
            data-project-category={category}
            aria-haspopup="dialog"
            aria-controls={`gallery-${id}`}
        >
            <img
                class="absolute inset-0 -z-10 size-full object-cover transition duration-500 group-hover:scale-105"
                src={image}
                alt=""
                loading="lazy"
                decoding="async"
            />
            <div class="absolute inset-0 -z-10 bg-gradient-to-t from-black/90 via-black/35 to-transparent"></div>
            <span class="mb-2 text-lg font-semibold text-white">{title}</span>
        </button>
    ))}
</div>


{graphicProjects.map(({ id, title, description, category, gallery, tools }) => (
    <dialog id={`gallery-${id}`}
        class="project-gallery" aria-labelledby={`gallery-title-${id}`}
        aria-describedby={`gallery-description-${id}`}>

        <header class="project-gallery__header">
            <form method="dialog">
                <button class="project-gallery__close" aria-label={`Cerrar galería de ${title}`}>
                    <span aria-hidden="true">&times;</span>
                </button>
            </form>
        </header>
        <aside class="project-gallery__tools">
            <button
                class="project-gallery__tools-button"
                type="button"
                aria-label={`Herramientas utilizadas en ${title}`}
                aria-expanded="false"
                aria-controls={`tools-${id}`}
                data-tools-toggle
            >
                <svg aria-hidden="true" viewBox="0 0 24 24" fill="none">
                    <path d="M14.7 6.3a5 5 0 0 0-6.4 6.4l-5.1 5.1a2.1 2.1 0 0 0 3 3l5.1-5.1a5 5 0 0 0 6.4-6.4l-3 3-3-3 3-3Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
            </button>
            <span class="project-gallery__tools-label">Herramientas</span>
            <section class="project-gallery__tools-popover" id={`tools-${id}`} aria-label={`Herramientas utilizadas en ${title}`}>
                <p>HERRAMIENTAS</p>
                <ul>
                    {tools.map((tool) => {
                        const ToolIcon = toolIcons[tool as keyof typeof toolIcons];

                        return (
                            <li>
                                {ToolIcon && (
                                    <span class="project-gallery__tool-icon" aria-hidden="true">
                                        <ToolIcon />
                                    </span>
                                )}
                                <span class="project-gallery__tool-name">{tool}</span>
                            </li>
                        );
                    })}
                </ul>
            </section>
        </aside>
        <div class="project-gallery__images">
            <div class="mb-8">
                <p class="project-gallery__category">{category}</p>
                <h2 id={`gallery-title-${id}`}>{title}</h2>
                <p id={`gallery-description-${id}`} class="project-gallery__description">{description}</p>
            </div>
            {gallery.map((galleryImage, index) => (
                <img
                    src={galleryImage}
                    alt={`${title} — imagen ${index + 1}`}
                    loading={index === 0 ? "eager" : "lazy"}
                    decoding="async"
                />
            ))}
        </div>
    </dialog>
))}

<script>
    const galleryButtons = document.querySelectorAll<HTMLButtonElement>("[data-gallery-open]");

    galleryButtons.forEach((button) => {
        button.addEventListener("click", () => {
            const projectId = button.dataset.galleryOpen;
            const dialog = projectId
                ? document.getElementById(`gallery-${projectId}`)
                : null;

            if (!(dialog instanceof HTMLDialogElement)) {
                throw new Error(`No se encontró la galería del proyecto "${projectId}".`);
            }

            dialog.showModal();
            document.documentElement.classList.add("project-gallery-open");
        });
    });

    document.querySelectorAll<HTMLDialogElement>(".project-gallery").forEach((dialog) => {
                const toolsButton = dialog.querySelector<HTMLButtonElement>("[data-tools-toggle]");

                toolsButton?.addEventListener("click", () => {
                    const isExpanded = toolsButton.getAttribute("aria-expanded") === "true";
                    toolsButton.setAttribute("aria-expanded", String(!isExpanded));
                    dialog.classList.toggle("project-gallery--tools-open", !isExpanded);
                });

                dialog.addEventListener("click", (event) => {
                    if (!(event.target instanceof Element)) {
                        return;
                    }

                    const clickedContent = event.target.closest(
                        "img, .project-gallery__images h2, .project-gallery__category, .project-gallery__description, .project-gallery__tools",
                    );

                    if (!clickedContent) {
                        dialog.close();
                    }
                });

                dialog.addEventListener("close", () => {
                    document.documentElement.classList.remove("project-gallery-open");
                    toolsButton?.setAttribute("aria-expanded", "false");
                    dialog.classList.remove("project-gallery--tools-open");
                });
            });
</script>