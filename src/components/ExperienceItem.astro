---
interface Props {
  company: string
  title: string
  description: string
  date: string
}

const { company, title, description, date } = Astro.props
---

    <div class="absolute w-3 h-3 rounded-full mt-1.5 -start-1.5 bg-primary">
    </div>
    <time class="time">{date}</time>
    <h5 class="subtitle-company mb-2"> {company} </h5>
    <h3 class="title-experience"> {title} </h3>
    <p class="description-experience mb-4">
    {description}
    </p>