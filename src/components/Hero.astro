---
import MailIcon from "../components/icons/email.astro";
import LinkedinIcon from "../components/icons/linkedin.astro";
import CvIcon from "../components/icons/cv.astro";
import SocialBtn from "../components/SocialBtn.astro";

const avatarUrl = import.meta.env.PUBLIC_AVATAR_URL || "/perfil.jpg";
---
<div class="">
    <img class="rounded-full size-12 mb-7" src={avatarUrl} alt="Anabel Huanca Moreano" width="48" height="48" fetchpriority="high" decoding="async">
    
    <h1 class="text_white text-2xl md:text-4xl lg:text-5xl 
    font-semibold pb-6 lg:pb-5 ">
        Hola mundo! Soy Anabel Huanca Moreano</h1>
    
    <h2 class="text-xl text-wrap opacity-80 max-w-[700px]"> <strong> Desarrolladora Front-End </strong> con experiencia en <strong> diseño UI/UX.</strong>
        Especializada en diseñar y desarrollar interfaces web intuitivas, accesibles y de alto rendimiento, desde los primeros wireframes y prototipos hasta su implementación.
    </h2>

    <nav class="flex gap-3 mt-8 flex-wrap">
        <SocialBtn href="https://www.linkedin.com/in/anabelhuancam/" >
            <LinkedinIcon class="size-4 md:size-6" aria-label="LinkedIn" />
            LinkedIn
            </SocialBtn>

        <SocialBtn href="https://drive.google.com/file/d/15liIRogFYmDzTx-2FMxNoykVoz-TfrTL/view?usp=sharing" >
            <CvIcon class="size-4  md:size-6" aria-label="PDF CV" />
            Ver Currículum
            </SocialBtn>

        <SocialBtn href="mailto:anabel.humor@gmail.com" >
            <MailIcon class="size-4  md:size-6" aria-label="Email" />
            Contáctame
            </SocialBtn>
    </nav>
</div>