---
import DevLayout from '../layouts/DevLayout.astro';

import SectionContainer from '../components/SectionContainer.astro';
import Experience from '../components/Experience.astro';

import Bag from '../components/icons/bag.astro';
import Code from '../components/icons/code.astro';
import TechIcon from '../components/icons/techIcon.astro';
import DesignIcon from '../components/icons/design.astro';
import Aboutme from '../components/icons/about.astro';
import DevProjects from '../components/DevProjects.astro';
import Tech from '../components/Tech.astro';
import CMS from '../components/CMS.astro';
import About from '../components/Dev/About.astro';
import Hero from '../components/Dev/Hero.astro';
---

<DevLayout title="Portafolio de Anabel Huanca Moreano">
	<main class="px-4">
		<SectionContainer class="py-16 pb-24 md:py-36">
			<Hero/>
		</SectionContainer>
		
		<SectionContainer id="experiencia">
			<h2 class="text-2xl font-bold mb-8 flex gap-x-3 items-center poppins">
				<Bag class="size-7"/>
				Experiencia laboral</h2>
			<Experience/>
		</SectionContainer>

	<SectionContainer id="proyectos">
		<h2 class="text-2xl font-bold mb-8 flex gap-x-3 items-center">
			<Code class="size-7"/>
			Proyectos</h2>
			<DevProjects/>
	</SectionContainer>

	<SectionContainer id="sobre-mi">
		<h2 class="text-2xl font-bold mb-8 flex gap-x-3 items-center">
			<Aboutme class="size-7"/>
			Acerca de mi</h2>
			<About/>	
	</SectionContainer>

	<SectionContainer >
		<h2 class="text-2xl font-bold mb-8 flex gap-x-3 items-center">
			<TechIcon class="size-6"/>
			Desarrollo</h2>
			<Tech/>
	</SectionContainer>
	
	<SectionContainer >
		<h2 class="text-2xl font-bold mb-8 flex gap-x-3 items-center">
			<TechIcon class="size-6"/>
			CMS</h2>
			<CMS/>
	</SectionContainer>
	</main>
</DevLayout>